// HandwritingCard 本地笔顺数据 v3
// 汉字使用 hanzi-writer-data 的 SVG 路径轮廓（filled outline, 1024×1024 Y-up 网格）
// 字母使用程序生成的粗线段 SVG 路径

export interface HandwritingStroke {
  path: string   // SVG path data (M/Q/L/C/Z)，1024×1024 网格，Y-up
  label: string  // 笔画类型名称
}

export function getStrokeOrder(character: string): HandwritingStroke[] | null {
  const data = STROKE_ORDER_MAP.get(character)
  if (data === undefined) {
    return null
  }
  return data
}

export function hasStrokeOrder(character: string): boolean {
  return STROKE_ORDER_MAP.has(character)
}

