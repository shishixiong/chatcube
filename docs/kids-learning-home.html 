<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>小星学习乐园 · 儿童端高保真原型</title>
<style>
  :root {
    --bg:      #FAF8F3;
    --surface: #FFFDF8;
    --fg:      #24211C;
    --muted:   #6F6A60;
    --border:  #DED8CC;
    --accent:  #FF9F43;

    --accent-2: #FFC46B;
    --star:     #F5B301;
    --on-hero:  #3A2506;
    --on-hero-2:#5A2F04;
    --on-gold:  #8A5A00;
    --subtle:   #746E64;
    --ink-soft: #4A423A;
    --avatar-1: #FFD79A;
    --avatar-2: #FFB45E;

    --math:    #4E8FE0;
    --english: #35A98A;
    --chinese: #E2603C;
    --games:   #8B72E0;

    /* WCAG-safe ink variants for text/icon roles (same hue, lower L).
       Locked hues above fail 4.5:1 as text; these pass on --surface and on 15% tint. */
    --math-ink:    #1D64BE;
    --english-ink: #22735D;
    --chinese-ink: #B53917;
    --games-ink:   #6A49DB;

    --font-display: 'Yuanti SC', 'Hiragino Maru Gothic ProN', 'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif;
    --font-body:    'PingFang SC', 'Hiragino Sans GB', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono:    ui-monospace, 'SF Mono', Menlo, monospace;

    --gap-xs: 8px; --gap-sm: 12px; --gap-md: 20px; --gap-lg: 32px;
    --radius: 10px; --radius-lg: 16px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background:
      radial-gradient(900px 460px at 50% -8%, color-mix(in oklch, var(--accent) 12%, transparent), transparent 62%),
      var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    padding: 28px 16px 52px;
  }
  b, strong { font-weight: 700; }
  h1, h2, h3 { text-wrap: balance; }
  p { text-wrap: pretty; }
  .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  :focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; border-radius: 10px; }

  .stage { max-width: 452px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; align-items: center; }
  .stage-head { width: 100%; display: flex; justify-content: space-between; align-items: baseline; padding-inline: 4px; }
  .stage-title { font-family: var(--font-display); font-weight: 700; font-size: 16px; letter-spacing: .01em; }
  .stage-note { font-family: var(--font-mono); font-size: 11px; color: var(--muted); letter-spacing: .03em; }

  /* ─── device ─────────────────────────────────────────── */
  .phone {
    position: relative;
    width: 390px; max-width: 100%; height: 842px;
    padding: 10px; border-radius: 48px;
    background: linear-gradient(160deg, color-mix(in oklch, var(--fg) 82%, white), color-mix(in oklch, var(--fg) 96%, black));
    box-shadow:
      0 34px 70px -22px color-mix(in oklch, var(--fg) 55%, transparent),
      0 10px 26px color-mix(in oklch, var(--fg) 18%, transparent);
  }
  .app {
    position: relative; width: 100%; height: 100%;
    border-radius: 39px; overflow: hidden; background: var(--bg);
    display: flex; flex-direction: column;
  }
  .island { position: absolute; top: 9px; left: 50%; transform: translateX(-50%); width: 110px; height: 30px; border-radius: 16px; background: var(--fg); z-index: 35; }
  .statusbar {
    position: relative; z-index: 30; flex: none; height: 48px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 26px 0 30px; font-size: 13px; font-weight: 600;
  }
  .statusbar .sb-icons { display: flex; gap: 5px; align-items: center; }
  .sb-bar { width: 17px; height: 10px; border: 1.4px solid currentColor; border-radius: 3px; position: relative; opacity: .85; }
  .sb-bar::after { content: ""; position: absolute; inset: 1.5px; right: 5px; background: currentColor; border-radius: 1px; }
  .sb-wifi { width: 14px; height: 10px; border-radius: 2px; background: currentColor; opacity: .85; clip-path: polygon(0 100%, 12% 70%, 30% 45%, 50% 25%, 72% 45%, 90% 70%, 100% 100%); }

  /* ─── scroll screen ──────────────────────────────────── */
  .screen { flex: 1; min-height: 0; overflow-y: auto; padding: 4px 20px 30px; scrollbar-width: none; }
  .screen::-webkit-scrollbar { display: none; }

  .home-head { display: flex; align-items: center; gap: 11px; padding: 2px 0; }
  .avatar {
    width: 42px; height: 42px; flex: none; border-radius: 14px; display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--on-gold);
    background: linear-gradient(150deg, var(--avatar-1), var(--avatar-2));
    box-shadow: 0 4px 10px color-mix(in oklch, var(--accent) 38%, transparent);
  }
  .greet { flex: 1; min-width: 0; }
  .greet h1 { margin: 0; font-family: var(--font-display); font-size: 17.5px; font-weight: 700; letter-spacing: -.01em; }
  .greet p { margin: 1px 0 0; font-size: 12px; color: var(--muted); }
  .star-total {
    display: flex; align-items: center; gap: 5px; flex: none;
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 8px 13px;
    box-shadow: 0 2px 6px color-mix(in oklch, var(--fg) 6%, transparent);
  }
  .star-total b { font-family: var(--font-display); font-size: 17px; }
  .star-total i { font-style: normal; font-size: 11px; color: var(--muted); }

  .ic { display: block; width: 20px; height: 20px; }
  .ic-star { fill: var(--star); }

  /* ─── hero: continue learning ────────────────────────── */
  .hero {
    position: relative; margin-top: 12px; border-radius: 24px; padding: 19px; overflow: hidden;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 16px 32px -10px color-mix(in oklch, var(--accent) 58%, transparent);
    color: var(--on-hero);
  }
  .hero::after { content: ""; position: absolute; top: -58px; right: -48px; width: 152px; height: 152px; border-radius: 50%; background: color-mix(in oklch, var(--surface) 30%, transparent); }
  .hero-top { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; }
  .hero-mascot {
    width: 60px; height: 60px; flex: none; border-radius: 20px; display: grid; place-items: center;
    background: color-mix(in oklch, var(--surface) 94%, transparent);
    box-shadow: 0 6px 14px color-mix(in oklch, var(--on-hero) 22%, transparent);
  }
  .hero-mascot .ic { width: 31px; height: 31px; }
  .hero-copy { flex: 1; min-width: 0; }
  .hero-eyebrow { display: block; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .07em; color: var(--on-hero-2); }
  .hero-copy h2 { margin: 4px 0 2px; font-family: var(--font-display); font-size: 23px; font-weight: 700; letter-spacing: -.01em; }
  .hero-copy p { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--on-hero-2); }
  .hero-actions { position: relative; z-index: 1; margin-top: 16px; display: flex; align-items: center; gap: 9px; }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 7px; min-height: 44px;
    font: inherit; font-size: 15px; font-weight: 700; color: var(--fg);
    background: var(--surface); border: 0; border-radius: 999px; padding: 0 18px; cursor: pointer;
    box-shadow: 0 6px 14px color-mix(in oklch, var(--on-hero) 24%, transparent);
    transition: background .15s ease, transform .06s ease;
  }
  .hero-cta:hover { background: color-mix(in oklch, var(--surface) 90%, var(--accent)); }
  .hero-cta:active { transform: translateY(1px); }
  .hero-stars { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 600; padding: 8px 11px; border-radius: 999px; background: color-mix(in oklch, var(--on-hero) 13%, transparent); }
  .hero-stars .ic { width: 13px; height: 13px; }
  .hero-more {
    margin-left: auto; min-height: 44px; font: inherit; font-size: 12.5px; font-weight: 600; color: var(--on-hero);
    background: transparent; border: 1px solid color-mix(in oklch, var(--on-hero) 42%, transparent);
    border-radius: 999px; padding: 0 14px; cursor: pointer; transition: background .15s ease;
  }
  .hero-more:hover { background: color-mix(in oklch, var(--on-hero) 13%, transparent); }

  /* ─── section blocks ─────────────────────────────────── */
  .block { margin-top: 22px; }
  .block-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; margin-bottom: 11px; }
  .block-head h2 { margin: 0; font-family: var(--font-display); font-size: 17.5px; font-weight: 700; letter-spacing: -.01em; }
  .block-head span { font-size: 11.5px; color: var(--subtle); }

  .subject-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; }
  .subject {
    display: flex; flex-direction: column; gap: 8px; text-align: left; font: inherit;
    background: var(--surface); border: 1px solid var(--border); border-radius: 19px; padding: 13px;
    cursor: pointer; box-shadow: 0 2px 8px color-mix(in oklch, var(--fg) 5%, transparent);
    transition: transform .06s ease, border-color .15s ease, box-shadow .15s ease;
  }
  .subject:hover { border-color: color-mix(in oklch, var(--subj) 58%, var(--border)); box-shadow: 0 10px 20px -8px color-mix(in oklch, var(--subj) 48%, transparent); }
  .subject:active { transform: translateY(1px); }
  .subject-icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: color-mix(in oklch, var(--subj) 15%, var(--surface)); color: var(--subj-ink); }
  .subject-icon .ic { width: 24px; height: 24px; }
  .subject-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; }
  .subject-sub { font-size: 11.5px; line-height: 1.45; color: var(--muted); min-height: 33px; }
  .subject-foot { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding-top: 9px; border-top: 1px dashed var(--border); font-family: var(--font-mono); font-size: 10.5px; color: var(--subtle); }
  .subject-foot .go { display: inline-flex; align-items: center; gap: 2px; color: var(--subj-ink); font-family: var(--font-body); font-size: 11.5px; font-weight: 700; }
  .subject-foot .go .ic { width: 12px; height: 12px; }

  /* ─── learning garden (daily records) ────────────────── */
  .days { display: flex; flex-direction: column; gap: 13px; }
  .day { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 14px; box-shadow: 0 2px 8px color-mix(in oklch, var(--fg) 5%, transparent); }
  .day-head { display: flex; align-items: baseline; gap: 8px; padding: 1px 2px 9px; }
  .day-head b { font-family: var(--font-display); font-size: 15px; font-weight: 700; }
  .day-head .dt { font-size: 11.5px; color: var(--muted); }
  .day-head .sum { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; color: var(--on-gold); background: color-mix(in oklch, var(--star) 24%, var(--surface)); border-radius: 999px; padding: 4px 9px; }
  .day-head .sum .ic { width: 11px; height: 11px; }
  .day-list { display: flex; flex-direction: column; }
  .rec {
    display: flex; align-items: center; gap: 11px; width: 100%; text-align: left; font: inherit; color: inherit;
    background: transparent; border: 0; border-top: 1px solid var(--border); padding: 11px 4px; border-radius: 12px; cursor: pointer;
    transition: background .15s ease;
  }
  .day-list .rec:first-child { border-top: 0; padding-top: 3px; }
  .rec:hover { background: color-mix(in oklch, var(--subj) 8%, transparent); }
  .rec-icon { width: 36px; height: 36px; flex: none; border-radius: 12px; display: grid; place-items: center; background: color-mix(in oklch, var(--subj) 15%, var(--surface)); color: var(--subj-ink); }
  .rec-icon .ic { width: 20px; height: 20px; }
  .rec-main { flex: 1; min-width: 0; }
  .rec-main b { display: block; font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rec-main small { font-size: 11px; color: var(--subtle); font-family: var(--font-mono); }
  .rec-stars { display: inline-flex; align-items: center; gap: 3px; flex: none; font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--on-gold); }
  .rec-stars .ic { width: 12px; height: 12px; }
  .rec-stars .z { font-family: var(--font-body); font-size: 11px; font-weight: 500; color: var(--subtle); }
  .rec.extra { display: none; }
  .day.expanded .rec.extra { display: flex; }
  .day-toggle {
    width: 100%; min-height: 44px; margin-top: 2px; border: 0; border-top: 1px dashed var(--border);
    background: transparent; color: var(--muted); font: inherit; font-size: 12px; font-weight: 600;
    cursor: pointer; border-radius: 0 0 12px 12px; transition: color .15s ease;
  }
  .day-toggle:hover { color: var(--fg); }

  .parent {
    margin: 22px auto 2px; min-height: 46px; display: flex; align-items: center; gap: 6px; justify-content: center;
    font: inherit; font-size: 12px; color: var(--subtle); background: transparent; border: 0; border-radius: 12px; padding: 12px 18px; cursor: pointer;
  }
  .parent:hover { color: var(--muted); }
  .parent .ic { width: 13px; height: 13px; }

  /* ─── subject agent chat ─────────────────────────────── */
  .chatview {
    position: absolute; inset: 0; z-index: 20; display: flex; flex-direction: column; background: var(--bg);
    transform: translateX(100%); transition: transform .3s cubic-bezier(.22,.61,.36,1);
  }
  .chatview.open { transform: translateX(0); }
  .chat-head { flex: none; display: flex; align-items: center; gap: 11px; padding: 52px 16px 12px; border-bottom: 1px solid var(--border); background: color-mix(in oklch, var(--bg) 94%, transparent); }
  .back { width: 44px; height: 44px; flex: none; border-radius: 13px; border: 1px solid var(--border); background: var(--surface); display: grid; place-items: center; cursor: pointer; }
  .back .ic { width: 18px; height: 18px; stroke: var(--fg); fill: none; }
  .back:hover { border-color: var(--subj-ink); }
  .teacher { width: 44px; height: 44px; flex: none; border-radius: 14px; display: grid; place-items: center; background: color-mix(in oklch, var(--subj) 15%, var(--surface)); color: var(--subj-ink); }
  .teacher .ic { width: 23px; height: 23px; }
  .chat-id { flex: 1; min-width: 0; }
  .chat-id h2 { display: block; margin: 0; font-family: var(--font-display); font-size: 16px; font-weight: 700; }
  .chat-id small { font-size: 11px; color: var(--muted); }
  .chat-tools { flex: none; display: flex; gap: 6px; padding: 9px 16px; overflow-x: auto; border-bottom: 1px solid var(--border); scrollbar-width: none; }
  .chat-tools::-webkit-scrollbar { display: none; }
  .chip { flex: none; font-size: 11px; color: var(--subj-ink); background: color-mix(in oklch, var(--subj) 12%, var(--surface)); border: 1px solid color-mix(in oklch, var(--subj) 30%, var(--border)); border-radius: 999px; padding: 5px 10px; }

  .chat-body { flex: 1; min-height: 0; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; scrollbar-width: none; }
  .chat-body::-webkit-scrollbar { display: none; }
  .bubble { max-width: 84%; border-radius: 16px; padding: 11px 14px; font-size: 14px; line-height: 1.55; }
  .bubble.t { background: var(--surface); border: 1px solid var(--border); border-top-left-radius: 5px; box-shadow: 0 2px 6px color-mix(in oklch, var(--fg) 5%, transparent); }
  .bubble.u { align-self: flex-end; background: var(--accent); color: var(--on-hero); border-bottom-right-radius: 5px; }

  .qcard { align-self: flex-start; width: 100%; max-width: 302px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 15px; box-shadow: 0 8px 18px -10px color-mix(in oklch, var(--subj) 55%, transparent); }
  .qcard .qtag { font-family: var(--font-mono); font-size: 10px; letter-spacing: .05em; color: var(--subj-ink); }
  .qcard .qexpr { font-family: var(--font-display); font-size: 27px; font-weight: 700; margin: 7px 0 1px; letter-spacing: .02em; }
  .qcard .qsub { font-size: 11.5px; color: var(--muted); margin: 0 0 12px; }
  .qopts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .qopts.three { grid-template-columns: 1fr 1fr 1fr; }
  .qopt { min-height: 46px; font-family: var(--font-display); font-size: 18px; font-weight: 700; color: var(--fg); background: var(--bg); border: 1px solid var(--border); border-radius: 12px; cursor: pointer; transition: border-color .15s ease, background .15s ease; }
  .qopt:hover { border-color: color-mix(in oklch, var(--subj) 55%, var(--border)); background: color-mix(in oklch, var(--subj) 9%, var(--surface)); }
  .qopt.correct { border-color: var(--english-ink); background: color-mix(in oklch, var(--english) 15%, var(--surface)); color: var(--english-ink); }
  .qopt.wrong { border-color: var(--chinese-ink); background: color-mix(in oklch, var(--chinese) 13%, var(--surface)); color: var(--chinese-ink); }

  /* english · listen card */
  .qcard .listen-row { display: flex; align-items: center; gap: 13px; margin: 13px 0 14px; }
  .qcard .play {
    width: 56px; height: 56px; flex: none; border-radius: 50%; border: 0; cursor: pointer;
    display: grid; place-items: center; background: var(--subj-ink); color: var(--surface);
    box-shadow: 0 8px 16px -6px color-mix(in oklch, var(--subj-ink) 62%, transparent);
    transition: background .15s ease, transform .06s ease;
  }
  .qcard .play .ic { width: 25px; height: 25px; }
  .qcard .play:hover { background: color-mix(in oklch, var(--subj-ink) 84%, black); }
  .qcard .play:active { transform: translateY(1px); }
  .qcard .play.playing { animation: ring 1.1s cubic-bezier(.22,.61,.36,1); }
  @keyframes ring { 0% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--subj) 42%, transparent); } 100% { box-shadow: 0 0 0 15px transparent; } }
  .qcard .listen-hint { font-size: 12.5px; line-height: 1.5; color: var(--muted); }
  .qopts.words .qopt { font-size: 16px; line-height: 1.15; }
  .qopt .ph { display: block; font-family: var(--font-body); font-size: 11px; font-weight: 500; color: var(--muted); margin-top: 3px; }

  /* chinese · hanzi card */
  .qcard .hanzi-row { display: flex; align-items: center; gap: 14px; margin: 12px 0 13px; }
  .qcard .tian {
    position: relative; width: 88px; height: 88px; flex: none; border-radius: 12px; display: grid; place-items: center;
    font-family: var(--font-display); font-size: 52px; font-weight: 700; color: var(--fg);
    background: color-mix(in oklch, var(--subj) 7%, var(--surface));
    border: 1.5px solid color-mix(in oklch, var(--subj) 40%, var(--border));
  }
  .qcard .tian::before, .qcard .tian::after { content: ""; position: absolute; background: color-mix(in oklch, var(--subj) 25%, transparent); }
  .qcard .tian::before { top: 7%; bottom: 7%; left: 50%; width: 1px; }
  .qcard .tian::after { left: 7%; right: 7%; top: 50%; height: 1px; }
  .qcard .hanzi-side { display: flex; flex-direction: column; gap: 7px; }
  .qcard .hs { display: flex; align-items: baseline; gap: 7px; font-size: 12px; color: var(--muted); }
  .qcard .hs b { font-family: var(--font-display); font-size: 15px; font-weight: 700; }
  .qcard .hs .num { color: var(--subj-ink); }

  /* games · sliding puzzle */
  .puzzle { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin: 12px 0 11px; }
  .puzzle .tile {
    aspect-ratio: 1 / 1; border: 1px solid color-mix(in oklch, var(--games) 30%, var(--border)); border-radius: 12px;
    background: color-mix(in oklch, var(--games) 13%, var(--surface)); color: var(--games-ink);
    font-family: var(--font-display); font-size: 20px; font-weight: 700; cursor: pointer;
    transition: background .15s ease, border-color .15s ease, transform .06s ease;
  }
  .puzzle .tile:hover { background: color-mix(in oklch, var(--games) 22%, var(--surface)); }
  .puzzle .tile:active { transform: translateY(1px); }
  .puzzle .tile.blank { background: transparent; border-style: dashed; border-color: var(--border); cursor: default; }
  .puzzle.done .tile { border-color: var(--english-ink); background: color-mix(in oklch, var(--english) 14%, var(--surface)); color: var(--english-ink); }
  .puzzle-meta { display: flex; align-items: center; justify-content: space-between; font-family: var(--font-mono); font-size: 11px; color: var(--subtle); }
  .puzzle-restart {
    width: 100%; min-height: 44px; margin-top: 10px; border-radius: 12px; cursor: pointer;
    border: 1px solid color-mix(in oklch, var(--games) 34%, var(--border)); background: transparent;
    color: var(--games-ink); font: inherit; font-size: 13px; font-weight: 700;
    transition: background .15s ease, transform .06s ease;
  }
  .puzzle-restart:hover { background: color-mix(in oklch, var(--games) 12%, var(--surface)); }
  .puzzle-restart:active { transform: translateY(1px); }

  .inputbar { flex: none; display: flex; gap: 9px; align-items: center; padding: 11px 14px 20px; border-top: 1px solid var(--border); }
  .inputbar .fake { flex: 1; height: 44px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); display: flex; align-items: center; padding: 0 16px; color: var(--subtle); font-size: 13.5px; }
  .inputbar .send { width: 44px; height: 44px; flex: none; border-radius: 50%; border: 0; background: var(--accent); display: grid; place-items: center; cursor: pointer; }
  .inputbar .send .ic { width: 19px; height: 19px; fill: var(--surface); }
  .inputbar .send:hover { background: color-mix(in oklch, var(--accent) 86%, black); }

  /* ─── star detail sheet ──────────────────────────────── */
