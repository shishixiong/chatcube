  </div>

<script>
(function () {
  const SUBJECTS = {
    math: {
      label: '学数学', teacher: '小星数学老师', tag: '口算 · 竖式 · 图形', icon: 'i-math', color: 'var(--math)', ink: 'var(--math-ink)',
      tools: ['口算出题', '竖式演示', '答案校验'],
      intro: '早上好，小明！我是数学老师。今天咱们练 20 以内的加法，先来一道热热身。',
      kind: 'choice', qtag: '数学题 · 20 以内加法', qexpr: '8 + 5 = ?', qsub: '选一选答案吧', opts: ['11', '12', '13', '14'], ans: '13'
    },
    english: {
      label: '学英语', teacher: '小星英语老师', tag: '听音 · 单词 · 认读', icon: 'i-english', color: 'var(--english)', ink: 'var(--english-ink)',
      tools: ['听音选词', '字母认读', '看图识词'],
      intro: '我是英语老师。先点一下小喇叭，听听它说的是哪个词，再选出来。',
      kind: 'listen', qtag: '听音选词 · 水果', qsub: '点小喇叭听读音，再选出正确的单词',
      word: 'apple', ans: 'apple',
      opts: [{ w: 'apple', ph: '苹果' }, { w: 'banana', ph: '香蕉' }, { w: 'car', ph: '小汽车' }, { w: 'dog', ph: '小狗' }]
    },
    chinese: {
      label: '学语文', teacher: '小星语文老师', tag: '拼音 · 识字 · 写字', icon: 'i-chinese', color: 'var(--chinese)', ink: 'var(--chinese-ink)',
      tools: ['拼音认读', '笔顺演示', '看图识词'],
      intro: '我是语文老师。看看田字格里的字，它应该读什么音呢？',
      kind: 'hanzi', qtag: '拼音认读 · 读一读', qsub: '它读什么？选一选',
      char: '日', strokes: '4', radical: '日',
      opts: ['rì', 'rè', 'lì', 'rí'], ans: 'rì'
    },
    games: {
      label: '小游戏', teacher: '小星游戏老师', tag: '华容道 · 迷宫 · 数独', icon: 'i-games', color: 'var(--games)', ink: 'var(--games-ink)',
      tools: ['数字华容道', '走迷宫', '数独'],
      intro: '我是游戏老师。今天玩数字华容道——点空格旁边的数字，把 1 到 8 排整齐！',
      kind: 'puzzle', qtag: '数字华容道 · 3×3', qsub: '点空格旁的方块移动，把 1–8 排整齐'
    },
    daily: {
      label: '继续学习', teacher: '小星老师', tag: '今日学习 · 全科', icon: 'i-star', color: 'var(--accent)', ink: 'var(--on-gold)',
      tools: ['今日计划', '全部学科'],
      intro: '早上好，小明！我们先接着昨天的图形比大小，再玩一局华容道，好吗？',
      kind: 'choice', qtag: '数学题 · 图形比大小', qexpr: '5 ○ 3', qsub: '中间应该填什么？', opts: ['>', '<', '='], ans: '>', cols: 3
    }
  };

  const TODAY = '2026-09-14';
  const $ = (id) => document.getElementById(id);

  // storage can throw inside sandboxed previews; never let that kill the wiring
  const store = (function () {
    try {
      const k = '__od_probe__';
      window.localStorage.setItem(k, '1');
      window.localStorage.removeItem(k);
      return window.localStorage;
    } catch (err) {
      const mem = Object.create(null);
      return {
        getItem: (k) => (k in mem ? mem[k] : null),
        setItem: (k, v) => { mem[k] = String(v); },
        removeItem: (k) => { delete mem[k]; }
      };
    }
  })();

  const screenEl = document.querySelector('.screen');
  let lastFocus = null;
  function setInert(el, on) {
    if (!el) return;
    if (on) el.setAttribute('inert', ''); else el.removeAttribute('inert');
  }
  function openLayer(el, focusTarget, trigger) {
    const active = document.activeElement;
    lastFocus = trigger || (active && active !== document.body ? active : null);
    setInert(el, false);
    setInert(screenEl, true);
    const t = typeof focusTarget === 'string' ? $(focusTarget) : focusTarget;
    if (t && t.focus) t.focus();
  }
  function closeLayer(el) {
    setInert(el, true);
    setInert(screenEl, false);
    if (lastFocus && document.contains(lastFocus) && lastFocus.focus) lastFocus.focus();
    lastFocus = null;
  }

  const chatview = $('chatview');
  const sheet = $('sheet');
  const scrim = $('scrim');
  const toastEl = $('toast');
  let toastTimer = null;
  let activeSubject = null;

  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('show'), 1900);
  }

  function heroSub() {
    return store.getItem('kid_today_session') === TODAY
      ? '小星老师 · 已进入今天的会话'
      : '小星老师 · 今天第一次学习，将开启新会话';
  }
  $('hero-sub').textContent = heroSub();

  const SOUND_ICON = '<svg class="ic" aria-hidden="true"><use href="#i-sound"></use></svg>';
  const PUZZLE_SOLVED = [1, 2, 3, 4, 5, 6, 7, 8, null];
  let puzzle = null;

  // real pronunciation via the device's own speech engine — no audio files, no network
  const CAN_SPEAK = typeof window !== 'undefined' && 'speechSynthesis' in window && 'SpeechSynthesisUtterance' in window;
  function pickVoice(lang) {
    const want = (lang || 'en-US').slice(0, 2).toLowerCase();
    const voices = window.speechSynthesis.getVoices() || [];
    return voices.find((v) => (v.lang || '').toLowerCase().indexOf(want) === 0) || null;
  }
  function speak(text, lang) {
    if (!CAN_SPEAK) { toast('当前环境不支持语音朗读，可先用文字提示'); return; }
    try {
      window.speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = lang || 'en-US';
      u.rate = 0.82;
      u.pitch = 1.05;
      const v = pickVoice(u.lang);
      if (v) u.voice = v;
      window.speechSynthesis.speak(u);
    } catch (err) { toast('语音朗读暂不可用'); }
  }

  function renderPuzzleCard(s) {
    return '<div class="qcard"><div class="qtag">' + s.qtag + '</div>' +
      '<div class="qsub" style="margin:6px 0 0">' + s.qsub + '</div>' +
      '<div class="puzzle" id="puzzle" role="group" aria-label="数字华容道"></div>' +
      '<div class="puzzle-meta"><span>步数 <b class="num" id="puzzle-moves">0</b></span><span id="puzzle-state">把 1–8 排整齐</span></div>' +
      '<button class="puzzle-restart" type="button" id="puzzle-restart">换一局</button></div>';
  }

  function renderPuzzleTiles(focusIndex) {
    const el = $('puzzle');
    if (!el || !puzzle) return;
    el.innerHTML = puzzle.tiles.map((n, i) =>
      '<button class="tile' + (n === null ? ' blank' : '') + '" type="button" data-i="' + i + '"' +
      (n === null ? ' disabled aria-hidden="true"' : '') + '>' + (n === null ? '' : n) + '</button>').join('');
    el.classList.toggle('done', puzzle.done);
    $('puzzle-moves').textContent = puzzle.moves;
    $('puzzle-state').textContent = puzzle.done ? '拼好啦！' : '把 1–8 排整齐';
    // keep keyboard focus on the tile that just moved instead of dropping to body
    if (typeof focusIndex === 'number') {
      const moved = el.querySelector('[data-i="' + focusIndex + '"]');
      if (moved) moved.focus();
    }
  }

  function newPuzzle() {
    const tiles = PUZZLE_SOLVED.slice();
    const neighbors = (b) => {
      const out = [];
      const r = Math.floor(b / 3), c = b % 3;
      if (r > 0) out.push(b - 3);
      if (r < 2) out.push(b + 3);
      if (c > 0) out.push(b - 1);
      if (c < 2) out.push(b + 1);
      return out;
    };
    let blank = 8, prev = -1;
    for (let k = 0; k < 60; k++) {
      const opts = neighbors(blank).filter((x) => x !== prev);
      const pick = opts[Math.floor(Math.random() * opts.length)];
      tiles[blank] = tiles[pick];
      tiles[pick] = null;
      prev = blank;
      blank = pick;
    }
    puzzle = { tiles, moves: 0, done: false };
  }

  function moveTile(i) {
    if (!puzzle || puzzle.done) return;
    const b = puzzle.tiles.indexOf(null);
    const row = Math.floor(i / 3) === Math.floor(b / 3) && Math.abs(i - b) === 1;
    const col = Math.abs(i - b) === 3;
    if (!row && !col) return;
    puzzle.tiles[b] = puzzle.tiles[i];
    puzzle.tiles[i] = null;
    puzzle.moves += 1;
    puzzle.done = puzzle.tiles.every((n, idx) => n === PUZZLE_SOLVED[idx]);
    renderPuzzleTiles(b);
    if (puzzle.done) toast('拼好啦，+1 颗星！');
  }

  function renderCard(s) {
    if (s.kind === 'puzzle') return renderPuzzleCard(s);
    if (s.kind === 'listen') {
      const opts = s.opts.map((o) => '<button class="qopt" type="button" data-ans="' + o.w + '"><span lang="en">' + o.w + '</span><span class="ph">' + o.ph + '</span></button>').join('');
      return '<div class="qcard"><div class="qtag">' + s.qtag + '</div>' +
        '<div class="listen-row"><button class="play" type="button" id="play" aria-label="播放读音">' + SOUND_ICON + '</button>' +
        '<span class="listen-hint">' + s.qsub + '</span></div>' +
        '<div class="qopts words">' + opts + '</div></div>';
    }
    if (s.kind === 'hanzi') {
      const opts = s.opts.map((o) => '<button class="qopt" type="button" data-ans="' + o + '">' + o + '</button>').join('');
      return '<div class="qcard"><div class="qtag">' + s.qtag + '</div>' +
        '<div class="hanzi-row"><div class="tian" aria-hidden="true">' + s.char + '</div>' +
        '<div class="hanzi-side"><span class="hs">笔画 <b class="num">' + s.strokes + '</b></span>' +
        '<span class="hs">部首 <b>' + s.radical + '</b></span></div></div>' +
        '<div class="qsub">' + s.qsub + '</div>' +
        '<div class="qopts">' + opts + '</div></div>';
    }
    const opts = s.opts.map((o) => '<button class="qopt" type="button" data-ans="' + o + '">' + o + '</button>').join('');
    return '<div class="qcard"><div class="qtag">' + s.qtag + '</div>' +
      '<div class="qexpr">' + s.qexpr + '</div>' +
      '<div class="qsub">' + s.qsub + '</div>' +
      '<div class="qopts' + (s.cols === 3 ? ' three' : '') + '">' + opts + '</div></div>';
  }

  function openChat(key, trigger) {
    const s = SUBJECTS[key];
    if (!s) return;
    activeSubject = key;
    chatview.style.setProperty('--subj', s.color);
    chatview.style.setProperty('--subj-ink', s.ink);
    $('chat-avatar').innerHTML = '<svg class="ic" aria-hidden="true"><use href="#' + s.icon + '"></use></svg>';
    $('chat-name').textContent = s.teacher;
    $('chat-tag').textContent = s.tag;
    $('chat-tools').innerHTML = s.tools.map((t) => '<span class="chip">' + t + '</span>').join('');
    $('chat-body').innerHTML =
      '<div class="bubble t">' + s.intro + '</div>' + renderCard(s) +
      '<div class="bubble u">好的，我们开始吧！</div>';
    if (s.kind === 'puzzle') { newPuzzle(); renderPuzzleTiles(); }
    chatview.classList.add('open');
    chatview.setAttribute('aria-hidden', 'false');
    $('chat-body').scrollTop = 0;
    openLayer(chatview, 'chat-back', trigger);
  }

  function closeChat() {
    if (!chatview.classList.contains('open')) return;
    chatview.classList.remove('open');
    chatview.setAttribute('aria-hidden', 'true');
    closeLayer(chatview);
    activeSubject = null;
  }

  function openSheet(trigger) {
    if (sheet.classList.contains('open')) return;
    sheet.classList.add('open');
    scrim.classList.add('open');
    openLayer(sheet, 'sheet-close', trigger);
  }
  function closeSheet() {
    if (!sheet.classList.contains('open')) return;
    sheet.classList.remove('open');
    scrim.classList.remove('open');
    closeLayer(sheet);
  }

  // parent gate (arithmetic) + today-at-a-glance summary
  const pmodal = $('pmodal');
  const pscrim = $('pscrim');
  const pmContent = $('pm-content');
  let pmAnswer = 0;

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  function renderParentGate() {
    const qs = [{ a: 6, b: 7 }, { a: 8, b: 5 }, { a: 9, b: 6 }, { a: 7, b: 8 }];
    const q = qs[Math.floor(Math.random() * qs.length)];
    pmAnswer = q.a + q.b;
    const opts = shuffle([pmAnswer, pmAnswer + 1, pmAnswer - 2, pmAnswer + 2]);
    pmContent.innerHTML =
      '<div class="pm-q"><span class="pm-eyebrow">家长验证 · 请回答</span>' +
      '<div class="qexpr">' + q.a + ' + ' + q.b + ' = ?</div>' +
      '<p class="pm-hint">为保护孩子使用，请先完成这道题</p></div>' +
      '<div class="pm-opts">' + opts.map((v) => '<button class="qopt" type="button" data-pm="' + v + '">' + v + '</button>').join('') + '</div>' +
      '<div class="pm-feedback" id="pm-feedback" role="status" aria-live="polite"></div>';
  }

  function renderParentSummary() {
    const cats = [
      { subj: 'var(--math)', ink: 'var(--math-ink)', icon: 'i-math', name: '数学题', meta: '答对 3 题', v: 3 },
      { subj: 'var(--english)', ink: 'var(--english-ink)', icon: 'i-english', name: '英语题', meta: '答对 2 题', v: 2 },
      { subj: 'var(--games)', ink: 'var(--games-ink)', icon: 'i-games', name: '数字华容道', meta: '完成 1 局', v: 1 }
    ];
    const events = [
      ['09:20', '数学题答对'], ['09:18', '数学题答对'], ['09:12', '数学题答对'],
      ['09:05', '英语题答对'], ['09:03', '英语题答对'], ['08:50', '数字华容道完成']
    ];
    pmContent.innerHTML =
      '<div class="pm-q" style="text-align:left"><span class="pm-eyebrow">家长视图 · 9月14日 周一</span>' +
      '<p class="pm-hint" style="margin-top:6px">小明今天的学习情况，一眼读完。</p></div>' +
      '<div class="star-hero"><span class="well" aria-hidden="true"><svg class="ic ic-star"><use href="#i-star"></use></svg></span>' +
      '<span><span class="n">6</span><span class="lbl"> 颗 · 今日获得</span></span></div>' +
      '<div class="sec-title"><b>学科分布</b><span>3 次活动</span></div>' +
      cats.map((c) => '<div class="cat" style="--subj:' + c.subj + ';--subj-ink:' + c.ink + '">' +
        '<span class="ci" aria-hidden="true"><svg class="ic"><use href="#' + c.icon + '"></use></svg></span>' +
        '<span class="cm"><b>' + c.name + '</b><small>' + c.meta + '</small></span>' +
        '<span class="cv">' + c.v + '<em>颗</em></span></div>').join('') +
      '<div class="sec-title"><b>今日记录</b><span>共 6 条</span></div><div>' +
      events.map((e) => '<div class="ev"><time>' + e[0] + '</time><span class="ed">' + e[1] + '</span>' +
        '<span class="pill g">+1<svg class="ic ic-star" aria-hidden="true"><use href="#i-star"></use></svg></span></div>').join('') + '</div>' +
      '<div class="pm-note">演示数据。儿童端仅呈现「今日概览」；完整家长报告与历史趋势在家长端呈现。</div>' +
      '<button class="pm-done" type="button" id="pm-done">知道了</button>';
  }

  function openParent(trigger) {
    renderParentGate();
    pmodal.classList.add('open');
    pmodal.setAttribute('aria-hidden', 'false');
    pscrim.classList.add('open');
    openLayer(pmodal, 'pmodal-close', trigger);
  }
  function closeParent() {
    if (!pmodal.classList.contains('open')) return;
    pmodal.classList.remove('open');
    pmodal.setAttribute('aria-hidden', 'true');
    pscrim.classList.remove('open');
    closeLayer(pmodal);
  }

  // continue learning — one session per day
  document.querySelector('.hero-cta').addEventListener('click', (e) => {
    const first = store.getItem('kid_today_session') !== TODAY;
    if (first) { store.setItem('kid_today_session', TODAY); toast('已为今天开启新的学习会话'); }
    else { toast('进入今天的学习会话'); }
    $('hero-sub').textContent = heroSub();
    openChat('daily', e.currentTarget);
  });
  $('hero-more').addEventListener('click', (e) => openSheet(e.currentTarget));
  $('sheet-close').addEventListener('click', closeSheet);
  scrim.addEventListener('click', closeSheet);

  document.querySelectorAll('[data-subject]').forEach((el) => {
    el.addEventListener('click', () => openChat(el.getAttribute('data-subject'), el));
  });

  $('chat-back').addEventListener('click', closeChat);
  $('chat-body').addEventListener('click', (e) => {
    const restart = e.target.closest('.puzzle-restart');
    if (restart && activeSubject === 'games') { newPuzzle(); renderPuzzleTiles(); toast('换了一局，再来一次！'); return; }
    const tile = e.target.closest('.tile');
    if (tile && activeSubject === 'games') { moveTile(Number(tile.getAttribute('data-i'))); return; }
    const play = e.target.closest('.play');
    if (play && activeSubject && SUBJECTS[activeSubject].word) {
      play.classList.remove('playing'); void play.offsetWidth; play.classList.add('playing');
      speak(SUBJECTS[activeSubject].word, 'en-US');
      return;
    }
    const opt = e.target.closest('.qopt');
    if (opt && activeSubject) {
      const s = SUBJECTS[activeSubject];
      if (opt.classList.contains('correct') || opt.classList.contains('wrong')) return;
      if (opt.getAttribute('data-ans') === s.ans) { opt.classList.add('correct'); toast('答对啦，+1 颗星'); }
      else { opt.classList.add('wrong'); toast('再想一想～'); }
    }
  });
  $('send').addEventListener('click', () => toast('原型演示：输入与发送为占位'));
  document.querySelector('.inputbar .fake').addEventListener('click', () => toast('原型演示：输入与发送为占位'));
  document.querySelector('.parent').addEventListener('click', (e) => openParent(e.currentTarget));
  $('pmodal-close').addEventListener('click', closeParent);
  pscrim.addEventListener('click', closeParent);
  pmodal.addEventListener('click', (e) => {
    if (e.target.closest('#pm-done')) { closeParent(); return; }
    const opt = e.target.closest('[data-pm]');
    if (!opt || opt.classList.contains('correct') || opt.classList.contains('wrong')) return;
    const fb = $('pm-feedback');
    if (Number(opt.getAttribute('data-pm')) === pmAnswer) {
      opt.classList.add('correct');
      if (fb) fb.textContent = '验证通过';
      setTimeout(renderParentSummary, 420);
    } else {
      opt.classList.add('wrong');
      if (fb) fb.textContent = '答案不对，再想一想～';
    }
  });

  document.querySelectorAll('.day-toggle').forEach((btn) => {
    btn.setAttribute('aria-expanded', 'false');
    btn.addEventListener('click', () => {
      const day = btn.closest('.day');
      const extra = day.querySelectorAll('.rec.extra');
      const open = day.classList.toggle('expanded');
      btn.textContent = open ? '收起' : '展开其余 ' + extra.length + ' 条';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeSheet(); closeParent(); closeChat(); }
  });
})();
</script>
</body>
</html>